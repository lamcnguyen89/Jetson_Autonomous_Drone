[Unit]
Description=Stanley follow-me startup script
After=network.target dev-ttyTHS1.device

[Service]
Type=simple
User=malneyugnfl
Group=malneyugnfl
SupplementaryGroups=dialout
Environment="HOME=/home/malneyugnfl"
WorkingDirectory=/home/malneyugnfl/Documents/SoftwareDev/Jetson_Autonomous_Drone
ExecStart=/usr/local/bin/python3.9 /home/malneyugnfl/Documents/SoftwareDev/Jetson_Autonomous_Drone/src/main.py --uri /dev/ttyTHS1 --video --video_path /home/malneyugnfl/Documents/SoftwareDev/Jetson_Autonomous_Drone/videos/ --log_path /home/malneyugnfl/Documents/SoftwareDev/Jetson_Autonomous_Drone/logs/
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target