# The installer creates .env from this file if missing; existing .env is preserved.
# It replaces the example SERVICE_USER placeholder with the invoking account.
# Read by Python, Bash (installer), and systemd. Use literal values, not $variables.
# Keep comments on their own lines for compatibility with all three readers.
# Quote values containing spaces. Do not use export or shell commands.
# Re-run the installer after changing SERVICE_USER/MAVLINK_PORT or moving the project.
SERVICE_USER=your-linux-username
# Base interpreter (Python 3.9-3.12) used to create the project's .venv.
# The service always runs .venv/bin/python.
BASE_PYTHON=/usr/bin/python3
# Prefer the controller's /dev/serial/by-id/... link when available.
# The configured controller must be connected when running the installer.
MAVLINK_PORT=/dev/ttyACM0
# Serial MAVLink baud rate; must match the flight controller (positive integer).
BAUD_RATE=57600

# Flight settings: loaded at startup. Restart after changing these values.
# Target altitude above home (meters) and allowed altitude error (meters).
ALTITUDE=2.0
ALTITUDE_FUZZINESS=0.1
# Ideal person-following distance and backoff trigger distance (meters).
MINIMUM_DISTANCE=4
BACKOFF_DISTANCE=3.6
# Maximum time without a flight-controller heartbeat (seconds).
HEARTBEAT_TIMEOUT=2
# Maximum follow/search yaw rate (degrees/second).
YAW_RATE=25
# Retained tuning value; currently unused by the movement rules.
YAW_MAX_DAMP=5.0
# Maximum combined horizontal speed (meters/second).
SPEED=1
# Position-error to horizontal-velocity gain (1/second), and deadband (meters).
FOLLOW_VELOCITY_GAIN=0.4
FOLLOW_POSITION_DEADBAND=0.15
# Altitude-error to vertical-velocity gain (1/second), and vertical speed cap (m/s).
ALTITUDE_VELOCITY_GAIN=1.5
MAX_VERTICAL_SPEED=0.5
# Minimum camera detection confidence (0 to 1).
DETECTION_THRESH=0.85

# Service notifications. Restart the service after changing these values.
NOTIFICATIONS_TEXT_ENABLED=true
NOTIFICATIONS_BEEPS_ENABLED=true
# Minimum seconds between rule/custom announcements; repeated rules stay quiet.
NOTIFICATIONS_MIN_INTERVAL=3.0
# Seconds to wait for the camera's first output before failing service startup.
CAMERA_READY_TIMEOUT=30.0
# Rule beep counts (0 to 6). Service readiness always requests six beeps.
NOTIFICATIONS_BACKOFF_BEEPS=3
NOTIFICATIONS_FOLLOW_BEEPS=1
NOTIFICATIONS_SEARCH_BEEPS=2
NOTIFICATIONS_NONE_BEEPS=0
